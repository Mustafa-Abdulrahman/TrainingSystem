            @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-4" role="alert"></div>
                }

            <!-- Main Form Card -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-journal-plus me-2"></i>Add / Edit Track</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        
                        <!-- Track Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Track Name</label>
                            <input asp-for="Name" type="text" class="form-control" placeholder="e.g. Asp.Net Core">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                       
                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Web application development"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Branch -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="BranchId" class="form-label fw-semibold">Branch</label>
                                <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                                    <option value="">Select a branch</option>
                                </select>
                                <span asp-validation-for="BranchId" class="text-danger small"></span>
                            </div>

                            <!-- Intake -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="IntakeId" class="form-label fw-semibold">Intake</label>
                                <select asp-for="IntakeId" asp-items="ViewBag.Intakes" class="form-select">
                                    <option value="">Select an Intake</option>
                                </select>
                                <span asp-validation-for="IntakeId" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Courses Section -->
                        @* <h5 class="mb-3 text-secondary"><i class="bi bi-book me-2"></i>Assign Courses & Hours</h5> *@
                        
